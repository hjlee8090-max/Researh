    },
    "supply_glut_or_price_drop": {
      "any": ["공급과잉", "가격하락", "판가하락", "재고증가", "감산", "수요둔화", "가격급락", "덤핑"],
      "exclude": ["가격상승", "판가인상"]
    },
    "earnings_miss_or_guidance_cut": {
      "any": ["어닝쇼크", "컨센서스하회", "예상치하회", "실적부진", "영업이익급감", "적자전환", "가이던스하향", "감익", "실적악화"],
      "exclude": ["상회", "호조"]
