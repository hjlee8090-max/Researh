{
  "version": "1.0",
  "last_updated": "2026-08-09",
  "purpose": "신규 진입 후보의 '모집단'(screening universe). scripts/screen_universe.py 가 이 풀을 상대강도(KOSPI 대비 60일 초과수익)+테마로 주간 랭킹해, config/candidates.json 에 없는 주도주를 '승격 제안'하고 만성 후행주를 '회전아웃 제안'한다(state/universe_screen.json). 후보가 손으로 넣은 소수 종목에 고정돼 섹터 로테이션에 못 따라가던 발굴 부재(v2.7 이전: 발굴 스크립트 0·프롬프트 지시문뿐)를 해소한다.",
  "ownership": "candidates.json 을 자동 수정하지 않는다 — screen_universe.py 는 제안만 만든다. 최종 승격·제거는 sunday_strategy(주간) 또는 0900 미배치 분기(tradable<2)에서 routine 이 thesis·theme_exposure(근거 URL 포함)와 함께 candidates.json 에 반영한다(환각 방지: 근거 없는 자동 추가 금지).",
  "theme_note": "theme 은 config/themes.json 의 id 와 맞춘다(strength × exposure = thematic 우대). 적절한 테마가 없으면 null — 그 종목은 상대강도로만 랭킹된다(테마 가점 0).",
  "screening_rules": {
    "rank_blend": {
      "relative_strength": 0.6,
      "thematic": 0.4
    },
    "benchmark": "state/market_snapshot.json.regime.ret_60d_pct (KOSPI 60일). 없으면 상대강도 중립(0.5) 폴백.",
    "promote_if": "candidates 에 없고 + 상대강도 상위(excess ≥ entry_filters.relative_strength_leader_widening.excess_min_pct, 기본 +10%p) + 5일 추세가 entry_filters.entry_filter_hard_floor_pct(기본 -22%) 위(자유낙하 아님).",
    "rotate_out_if": "현재 candidate 인데 상대강도 최하위 밴드(excess ≤ rotate_out_excess_pct, 기본 -25%p) — 만성 후행주(반도체 주도장의 조선·금융류 알파누수 차단).",
    "rotate_out_excess_pct": -25.0,
    "promote_max_per_run": 4,
    "exclude_structural_bear": true
  },
