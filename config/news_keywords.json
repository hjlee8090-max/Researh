    "type_keywords_en": {
      "global_customer_demand": {
        "impact_pct": 6.0,
        "any": ["record orders", "capex increase", "raise capex", "AI demand surge", "data center expansion", "sold out", "supply deal", "long-term agreement", "raises forecast", "beats estimates"],
